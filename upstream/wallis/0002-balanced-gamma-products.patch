+module
+
+public import Mathlib.Analysis.SpecialFunctions.Gamma.Beta
+
+/-!
+# Gamma limits of balanced products of linear factors
+
+The partial products of `(∏ i ∈ s, (x i + k)) / (∏ i ∈ s, (y i + k))`
+converge to a quotient of Gamma products when all shifts are positive and
+their sums agree. Both families have the same finite index set, so their
+numbers of factors agree. The empty index set is allowed.
+-/
+
+public section
+
+namespace Real
+
+open Filter Topology
+
+private theorem prod_GammaSeq {ι : Type*} (s : Finset ι) (x : ι → ℝ)
+    {n : ℕ} (hn : 0 < n) :
+    (∏ i ∈ s, GammaSeq (x i) n) =
+      (n : ℝ) ^ (∑ i ∈ s, x i) * (n.factorial : ℝ) ^ s.card /
+        ∏ k ∈ Finset.range (n + 1), ∏ i ∈ s, (x i + k) := by
+  have hn' : (0 : ℝ) < n := Nat.cast_pos.mpr hn
+  simp only [GammaSeq, Finset.prod_div_distrib, Finset.prod_mul_distrib, Finset.prod_const]
+  rw [← rpow_sum_of_pos hn', Finset.prod_comm]
+
+private theorem prod_GammaSeq_div_prod_GammaSeq {ι : Type*} (s : Finset ι) (x y : ι → ℝ)
+    (hx : ∀ i ∈ s, 0 < x i) (hy : ∀ i ∈ s, 0 < y i)
+    (hbalance : ∑ i ∈ s, x i = ∑ i ∈ s, y i) {n : ℕ} (hn : 0 < n) :
+    (∏ i ∈ s, GammaSeq (y i) n) / (∏ i ∈ s, GammaSeq (x i) n) =
+      ∏ k ∈ Finset.range (n + 1), (∏ i ∈ s, (x i + k)) / (∏ i ∈ s, (y i + k)) := by
+  have hn' : (0 : ℝ) < n := Nat.cast_pos.mpr hn
+  have hscale : (n : ℝ) ^ (∑ i ∈ s, y i) * (n.factorial : ℝ) ^ s.card ≠ 0 := by positivity
+  have hxp : (∏ k ∈ Finset.range (n + 1), ∏ i ∈ s, (x i + k)) ≠ 0 := by
+    apply ne_of_gt
+    exact Finset.prod_pos fun k _ ↦ Finset.prod_pos fun i hi ↦
+      add_pos_of_pos_of_nonneg (hx i hi) (Nat.cast_nonneg k)
+  have hyp : (∏ k ∈ Finset.range (n + 1), ∏ i ∈ s, (y i + k)) ≠ 0 := by
+    apply ne_of_gt
+    exact Finset.prod_pos fun k _ ↦ Finset.prod_pos fun i hi ↦
+      add_pos_of_pos_of_nonneg (hy i hi) (Nat.cast_nonneg k)
+  rw [prod_GammaSeq s x hn, prod_GammaSeq s y hn, hbalance, Finset.prod_div_distrib]
+  field_simp [hscale, hxp, hyp]
+
+/-- A balanced product of positive linear factors converges to a quotient of Gamma products. -/
+theorem tendsto_prod_linear_factors {ι : Type*} (s : Finset ι) (x y : ι → ℝ)
+    (hx : ∀ i ∈ s, 0 < x i) (hy : ∀ i ∈ s, 0 < y i)
+    (hbalance : ∑ i ∈ s, x i = ∑ i ∈ s, y i) :
+    Tendsto (fun n : ℕ ↦
+      ∏ k ∈ Finset.range n, (∏ i ∈ s, (x i + k)) / (∏ i ∈ s, (y i + k)))
+      atTop (𝓝 ((∏ i ∈ s, Gamma (y i)) / (∏ i ∈ s, Gamma (x i)))) := by
+  have hden : (∏ i ∈ s, Gamma (x i)) ≠ 0 :=
+    (Finset.prod_pos fun i hi ↦ Gamma_pos_of_pos (hx i hi)).ne'
+  have hlim := (tendsto_finsetProd s (fun i _ ↦ GammaSeq_tendsto_Gamma (y i))).div
+    (tendsto_finsetProd s (fun i _ ↦ GammaSeq_tendsto_Gamma (x i))) hden
+  apply (tendsto_add_atTop_iff_nat 1).mp
+  apply hlim.congr'
+  filter_upwards [eventually_gt_atTop 0] with n hn
+  exact prod_GammaSeq_div_prod_GammaSeq s x y hx hy hbalance hn
+
+end Real
